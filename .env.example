# SchemaPilot environment variables.
# Copy this file to .env and fill in your values. SchemaPilot loads .env from
# the project root AND from the current working directory (cwd wins).

# --- LLM provider ---
# Supported: google, openai, anthropic, openai-compatible, ollama, local
# LLM_PROVIDER=google

# --- Model name ---
# LLM_MODEL_NAME=gemini-2.0-flash

# --- API key (required for cloud providers) ---
# LLM_API_KEY=your-key-here

# --- Base URL (required for openai-compatible / ollama) ---
# LLM_BASE_URL=http://localhost:11434/v1

# --- LLM temperature (default: 0.0 — deterministic for SQL) ---
# LLM_TEMPERATURE=0.0

# --- Database ---
# Override the active connection at runtime (useful for CI or one-off runs).
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=

# --- Security ---
# Allow mutating queries globally (NOT recommended; mutation is planned
# for a future interactive-approval panel).
# ALLOW_MUTATING_QUERIES=false

# --- Integration testing ---
# Set SCHEMAPILOT_IT=1 to enable the live six-engine integration matrix.
# SCHEMAPILOT_IT=0
